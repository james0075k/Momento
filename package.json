{
  "name": "momento",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* run dev",
    "dev:local": "pnpm --parallel --filter @momento/api --filter @momento/web run dev:local",
    "build": "pnpm --recursive --if-present run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.22.0",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "node ./node_modules/prettier/bin/prettier.cjs --write"
    ],
    "*.{json,md,css}": [
      "node ./node_modules/prettier/bin/prettier.cjs --write"
    ]
  }
}
