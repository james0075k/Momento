# --- apps/web (Next.js) ---
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SHOP_WHATSAPP_NUMBER=
# Search: token from Google Search Console > Settings > Ownership verification > HTML tag (the content="..." value).
GOOGLE_SITE_VERIFICATION=
# Optional LocalBusiness details for search results. Leave blank to publish only the city.
NEXT_PUBLIC_BUSINESS_CITY=Kathmandu
NEXT_PUBLIC_BUSINESS_STREET=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_OPENS=10:00
NEXT_PUBLIC_BUSINESS_CLOSES=19:00
# Error monitoring (Sentry). Leave blank to switch it off. The auth token uploads source maps at build time.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Vercel Analytics turns on by itself on Vercel (VERCEL=1); enable it in the project's Analytics tab.

# Lets the API refresh the web cache when Settings change (feature flags). Same value in both apps, 16+ characters.
REVALIDATE_SECRET=
# Requests per IP per 15 minutes for the whole API. Blank means 300.
RATE_LIMIT_GLOBAL=

# --- apps/api (Express) ---
NODE_ENV=
PORT=
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/momento
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FIRST_ADMIN_NAME=admin@momento.com
FIRST_ADMIN_EMAIL=admin@momento.com
FIRST_ADMIN_PASSWORD=
SHOP_WHATSAPP_NUMBER=
# Server-side Sentry DSN and the web address the API pings after Settings change (https://yourdomain/api/revalidate).
SENTRY_DSN=
WEB_REVALIDATE_URL=
# Keys the phone hash used by referral codes (16+ characters). Falls back to JWT_ACCESS_SECRET; changing it resets who used a referral.
REFERRAL_PEPPER=


# Dev only: show sample products, services and reviews when the API has none. Set to 1 to force it (demos).
# SAMPLE_CONTENT=
# Daily summary email (Resend). All four are needed; the summary route answers 503 until they are set.
SITE_URL=
RESEND_API_KEY=
SUMMARY_TO_EMAIL=
SUMMARY_FROM_EMAIL=
# Shared with the scheduler (GitHub secret of the same name). 16+ characters.
CRON_SECRET=
